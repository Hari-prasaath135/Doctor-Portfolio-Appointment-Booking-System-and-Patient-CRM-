{
  "name": "dr-Vijay-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend for Dr. Vijay Clinic",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
