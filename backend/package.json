    "helmet": "^8.0.0",
    "mapbox-gl": "^3.30.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.0",
    "razorpay": "^2.9.8",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
