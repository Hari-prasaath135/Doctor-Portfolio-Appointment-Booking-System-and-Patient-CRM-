# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Admin SDK
# Option A: Path to your service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#
# Option B: Inline credentials (use one or the other)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────────────────────
# Pinelabs (Plural Pay) Payment Gateway
# ─────────────────────────────────────────────────────────────────────────────
PINELABS_CLIENT_ID=your-pinelabs-client-id
PINELABS_CLIENT_SECRET=your-pinelabs-client-secret
PINELABS_MERCHANT_ID=your-merchant-id
PINELABS_ENV=UAT
# UAT:  https://pluraluat.v2.pinepg.in
# PROD: https://api.pluralpay.in
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINELABS_WEBHOOK_SECRET=your-webhook-secret

# ─────────────────────────────────────────────────────────────────────────────
# Zoom Video API
# ─────────────────────────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ─────────────────────────────────────────────────────────────────────────────
# Resend (Email Notifications)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=clinic@drvijai.com
EMAIL_FROM_NAME=Dr. Vijai Clinic
